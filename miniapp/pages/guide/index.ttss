/* P-02 测试引导页 · 版式见《美术资产》§3 */

page {
  background-color: #1b1035;
  background-image:
    radial-gradient(110% 50% at 50% -8%, rgba(232, 200, 122, 0.14) 0%, rgba(232, 200, 122, 0) 62%),
    linear-gradient(135deg, #1b1035 0%, #3a2a6b 100%);
  background-repeat: no-repeat;
}

.p2 {
  display: flex;
  flex-direction: column;
  padding-top: 72rpx;
  padding-bottom: 32rpx;
}

.p2__head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.p2__title {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #f5efe6;
}

.p2__subtitle {
  margin-top: 14rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(232, 200, 122, 0.85);
}

/* 三步说明卡：序号圆标 44rpx + 标题 / 说明（美术资产 §3.2） */
.p2__steps {
  margin-top: 56rpx;
}

.p2__step {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 32rpx;
}

.p2__step + .p2__step {
  margin-top: 24rpx;
}

.p2__step-no {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid rgba(232, 200, 122, 0.55);
  border-radius: 50%;
  font-size: 22rpx;
  color: #e8c87a;
}

.p2__step-body {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.p2__step-title {
  font-size: 28rpx;
  color: #f5efe6;
}

.p2__step-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.62;
  color: rgba(245, 239, 230, 0.66);
}

.p2__note {
  margin-top: 36rpx;
  text-align: center;
}

.p2__cta {
  width: 100%;
  margin-top: 48rpx;
}

.p2__foot {
  width: 100%;
  margin-top: auto;
  padding-top: 48rpx;
}
